# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
# Set NO_DB=true to run in memory-only mode (no Redis/MongoDB needed)
NO_DB=true
REDIS_URL=redis://localhost:6379
MONGO_URI=mongodb://localhost:27017/rateguard

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=24h

# ─── Rate Limiting ──────────────────────────────────────────────────────────
ALGORITHM=sliding-window
DEFAULT_RATE_LIMIT=100
DEFAULT_WINDOW_SECONDS=60
BLOCK_DURATION_MINUTES=10
FREE_TIER_LIMIT=100
PRO_TIER_LIMIT=1000

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
